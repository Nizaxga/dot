#!/usr/bin/env bash

app_dirs=(
    "$HOME/.local/share/applications"
    "/usr/local/share/applications"
    "/usr/share/applications"
)

apps=$(find "${app_dirs[@]}" -type f -name '*.desktop' 2>/dev/null)

selected=$(
    while IFS= read -r file; do
        name=$(grep -m1 '^Name=' "$file" | cut -d= -f2-)
        [ -n "$name" ] && printf '%s\n' "$name"
    done <<< "$apps" | sort -fu | ~/.dot/Scripts/wmenu-wrap -i -p "Applications" -l 10
)

[ -z "$selected" ] && exit 0

desktop_file=$(
    while IFS= read -r file; do
        name=$(grep -m1 '^Name=' "$file" | cut -d= -f2-)
        [ "$name" = "$selected" ] && {
            printf '%s\n' "$file"
            break
        }
    done <<< "$apps"
)

[ -n "$desktop_file" ] &&
    gtk-launch "$(basename "$desktop_file" .desktop)"
