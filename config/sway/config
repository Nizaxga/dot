font pango:IosevkaNLNice Nerd Font 10

set $mod      Mod4
set $left     h
set $down     j
set $up       k
set $right    l
set $term     ghostty

set $appMenu     ~/.dot/Scripts/wmenu-drun
set $clipMenu ~/.dot/Scripts/wmenu-clip

exec mako
exec waybar
# exec ryoku-shell daemon
exec dbus-update-activation-environment
exec blueman-applet
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

default_border pixel 1
default_floating_border pixel 1

client.focused          #d0cca8 #1a1814 #d0cca8 #706c58 #d0cca8
client.focused_inactive #706c58 #1a1814 #c0bc9e #524e3e #524e3e
client.unfocused        #524e3e #1a1814 #c0bc9e #524e3e #524e3e
client.urgent           #ff4444 #1a1814 #d0cca8 #ff4444 #ff4444
client.placeholder      #2c2a24 #1a1814 #c0bc9e #2c2a24 #2c2a24

gaps inner 2
gaps outer 2

focus_follows_mouse no
mouse_warping container

corner_radius 8
shadows enable
blur enable

bindsym $mod+$left          focus left
bindsym $mod+$right         focus right
bindsym $mod+$down          focus down
bindsym $mod+$up            focus up

bindsym $mod+Shift+$left    move left
bindsym $mod+Shift+$right   move right
bindsym $mod+Shift+$down    move down
bindsym $mod+Shift+$up      move up

bindsym $mod+Return         exec $term
bindsym $mod+d              exec $appMenu
bindsym $mod+Shift+x        exec swaylock
bindsym $mod+v              exec $clipMenu

bindsym $mod+w              layout tabbed
bindsym $mod+e              layout toggle split
bindsym $mod+space          floating toggle
bindsym $mod+f              fullscreen toggle
bindsym $mod+q              kill

bindsym $mod+1              workspace number 1
bindsym $mod+2              workspace number 2
bindsym $mod+3              workspace number 3
bindsym $mod+4              workspace number 4
bindsym $mod+5              workspace number 5
bindsym $mod+6              workspace number 6
bindsym $mod+7              workspace number 7
bindsym $mod+8              workspace number 8
bindsym $mod+9              workspace number 9
bindsym $mod+0              workspace number 10

bindsym $mod+Shift+1        move container to workspace number 1
bindsym $mod+Shift+2        move container to workspace number 2
bindsym $mod+Shift+3        move container to workspace number 3
bindsym $mod+Shift+4        move container to workspace number 4
bindsym $mod+Shift+5        move container to workspace number 5
bindsym $mod+Shift+6        move container to workspace number 6
bindsym $mod+Shift+7        move container to workspace number 7
bindsym $mod+Shift+8        move container to workspace number 8
bindsym $mod+Shift+9        move container to workspace number 9
bindsym $mod+Shift+0        move container to workspace number 10

mode "resize" {
    bindsym k resize shrink height 50 px
    bindsym j resize grow height 50 px

    bindsym h resize shrink width 50 px
    bindsym l resize grow width 50 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r          mode "resize"
bindsym $mod+Shift+c    reload
bindsym $mod+Shift+q    exec swaymsg exit

for_window [app_id="pavucontrol"] floating enable
for_window [window_role="dialog"] floating enable

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

input * {
    xkb_layout us,th
    xkb_options grp:caps_toggle
    scroll_factor 0.5
    repeat_delay 150
}

output eDP-1 {
    # bg ~/Pictures/Wallpapers/yoru-darker-gray-bg.jpg fill
    scale 1.25
}

exec swayidle -w \
    timeout 300 'swaylock' \
    timeout 420 'loginctl suspend' \
    after-resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock' \
    lock 'swaylock'

