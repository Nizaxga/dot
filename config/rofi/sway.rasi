* {
    background:     #323232;
    background-alt: #404040;
    foreground:     #ffffff;
    selected:       #4c7899;
    urgent:         #cc6666;
    font: "IosevkaNLNice Nerd Font 11";
}

window {
    width: 35%;
    background-color: @background;
    border: 2px;
    border-radius: 6px;
    border-color: @selected;
    padding: 12px;
}

mainbox {
    background-color: @background;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    border-radius: 6px;
    background-color: @background-alt;
    text-color: @foreground;
    padding: 10px;
    children: [ entry ];
}

prompt {
    text-color: @selected;
}

entry {
    background-color: @background-alt;
    text-color: @foreground;
    placeholder: "Search...";
    placeholder-color: #aaaaaa;
}

listview {
    background-color: @background;
    columns: 1;
    lines: 7;
    spacing: 2px;
    fixed-height: true;
}

element {
    border-radius: 6px;
    background-color: @background;
    text-color: @foreground;
    padding: 6px;
}

element selected {
    background-color: @selected;
    text-color: @foreground;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    background-color: inherit;
    size: 20px;
    margin: 0px 10px 0px 0px;
}
