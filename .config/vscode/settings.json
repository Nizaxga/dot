{
    "editor.fontSize": 16,
    "editor.formatOnSave": true,
    "editor.wordWrap": "off",
    "editor.wordWrapColumn": 80,
    "editor.lineNumbers": "relative",
    "editor.inlayHints.enabled": "off",
    "editor.minimap.enabled": false,
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.fontFamily": "IosevkaNL-Nice",
    "editor.renderLineHighlight": "none",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.bracketPairColorization.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            { "name": "numeric colorTheme", "scope": "constant.numeric", "settings": { "foreground": "#9e95c7" } },
            { "name": "bold all yellow", "scope": [ "keyword", "storage", "variable.language", "constant.language", "keyword.other.unit" ], "settings": { "fontStyle": "bold" } }
        ]
    },
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.fontFamily": "IosevkaNLNice Nerd Font",
    "workbench.layoutControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "window.titleBarStyle": "custom",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.autoReveal": false,
    "vim.incsearch": true,
    "vim.highlightedyank.enable": true,
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.enableNeovim": true,
    "vim.handleKeys": {
        "<C-k>": false,
        "<C-j>": false,
        "<C-b>": false,
        "<C-r>": false,
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": [ "]", "c" ], "commands": [ "editor.action.dirtydiff.next" ] },
        { "before": [ "[", "c" ], "commands": [ "editor.action.dirtydiff.prev" ] },
        { "before": ["d", "p"], "commands": ["git.revertSelectedRanges" ] },
        { "before": [ "<leader>", "|" ], "commands": [ ":vsplit" ] },
        { "before": [ "+" ], "commands": [ "workbench.action.increaseViewSize" ] },
        { "before": [ "-" ], "commands": [ "workbench.action.decreaseViewSize" ] },
        { "before": [ "x" ], "after": [ "\"", "_", "x" ] },
        { "before": [ "c" ], "after": [ "\"", "_", "c" ] },
        { "before": [ "Y" ], "after": [ "y", "$" ] },
        { "before": [ "j" ], "after": [ "g", "j" ] },
        { "before": [ "k" ], "after": [ "g", "k" ] },
        { "before": [ "n" ], "after": [ "n", "z", "z", "z", "v" ] },
        { "before": [ "N" ], "after": [ "N", "z", "z", "z", "v" ] },
        { "before": [ "*" ], "after": [ "*", "z", "z", "z", "v" ] },
        { "before": [ "#" ], "after": [ "#", "z", "z", "z", "v" ] },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        { "before": [ "x" ], "after": [ "\"", "_", "x" ] },
        { "before": [ "c" ], "after": [ "\"", "_", "c" ] },
        { "before": [ ">" ], "commands": [ "editor.action.indentLines", "vim.reselectLastVisualSelection" ] },
        { "before": [ "<" ], "commands": [ "editor.action.outdentLines", "vim.reselectLastVisualSelection" ] }
    ],
    "extensions.experimental.affinity": { "vscodevim.vim": 1, },
    "chat.agentsControl.enabled": "hidden",
    "telemetry.telemetryLevel": "off",
    "breadcrumbs.enabled": false,
    "extensions.autoUpdate": "off",
    "diffEditor.ignoreTrimWhitespace": true,
    "workbench.sideBar.location": "right",
    "chat.disableAIFeatures": true,
    "notebook.lineNumbers": "on",
    "workbench.colorTheme": "Tsoding Emacs Gruber Minimal",
    "search.searchEditor.focusResultsOnSearch": true,
    "workbench.experimental.modernUI": true,
    "workbench.iconTheme": "vscode-icons",
}
