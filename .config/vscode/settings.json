{
    "chat.disableAIFeatures": true,

    "editor.fontSize": 16,
    "editor.formatOnSave": false,
    "editor.wordWrap": "off",
    "editor.wordWrapColumn": 80,
    "editor.lineNumbers": "relative",
    "editor.inlayHints.enabled": "off",
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.fontFamily": "IosevkaNL-Nice",
    "editor.renderLineHighlight": "none",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.bracketPairColorization.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.minimap.enabled": false,

    "terminal.integrated.fontSize": 16,
    "terminal.integrated.fontFamily": "IosevkaNLNice Nerd Font",
    "terminal.external.osxExec": "Ghostty.app",

    "workbench.browser.showInTitleBar": false,
    "workbench.startupEditor": "none",
    "workbench.editor.enablePreview": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.sideBar.location": "right",
    "workbench.experimental.modernUI": true,
    "workbench.layoutControl.enabled": false,
    "workbench.colorTheme": "Gruvbox Dark Hard",
    "workbench.iconTheme": "vscode-icons",

    "window.commandCenter": false,
    "window.titleBarStyle": "custom",

    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": true,
    "explorer.autoReveal": false,

    "vim.incsearch": true,
    "vim.highlightedyank.enable": true,
    "vim.useSystemClipboard": true,
    "vim.hlsearch": true,
    "vim.leader": "<space>",
    "vim.enableNeovim": true,
    "vim.handleKeys": {
        "<C-k>": false,
        "<C-j>": false,
        "<C-b>": false,
        "<C-r>": false,
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        { "before": [ "]", "c" ],           "commands": [ "editor.action.dirtydiff.next" ] },
        { "before": [ "[", "c" ],           "commands": [ "editor.action.dirtydiff.previous" ] },
        { "before": [ "]", "d" ],           "commands": [ "editor.action.marker.next" ] },
        { "before": [ "[", "d" ],           "commands": [ "editor.action.marker.prev" ] },
        { "before": [ "+" ],                "commands": [ "workbench.action.increaseViewSize" ] },
        { "before": [ "-" ],                "commands": [ "workbench.action.decreaseViewSize" ] },
        { "before": [ "x" ],                "after": [ "\"", "_", "x" ] },
        { "before": [ "Y" ],                "after": [ "y", "$" ] },
    ],
    "vim.visualModeKeyBindingsNonRecursive": [
        { "before": [ ">" ], "commands": [ "editor.action.indentLines", "vim.reselectLastVisualSelection" ] },
        { "before": [ "<" ], "commands": [ "editor.action.outdentLines", "vim.reselectLastVisualSelection" ] },
        { "before": [ "x" ], "after": [ "\"", "_", "x" ] },
    ],
    "extensions.experimental.affinity": { "vscodevim.vim": 1, },

    "scm.repositories.selectionMode": "single",
    "telemetry.telemetryLevel": "off",
    "breadcrumbs.enabled": false,
    "extensions.autoUpdate": "off",

    "diffEditor.ignoreTrimWhitespace": true,
    "notebook.output.scrolling": true,
    "notebook.output.minimalErrorRendering": true,
    "notebook.displayOrder": [ "image/png", "text/html", "text/plain", "application/vnd.jupyter.widget-view+json" ],
    "notebook.lineNumbers": "on",
}