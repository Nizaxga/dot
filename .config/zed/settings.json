{
  "base_keymap": "VSCode",
  "cursor_blink": false,
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "scrollbar": { "show": "never" },
  "vim": {
    "use_smartcase_find": true,
  },
  "command_aliases": {
    "yp": "workspace::CopyPath",
    "open": "editor::RevealInFileManager",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": { "font_style": "normal" },
      "keyword": { "font_style": "normal" },
      "string": { "font_style": "normal" },
      "function": { "font_style": "normal" },
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "disable_ai": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "ui_font_family": "IosevkaNL-Nice",
  "buffer_font_family": "IosevkaNL-Nice",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruber Darker"
  },
  "diagnostics": {
    "inline": { "enabled": true, },
  },
}
