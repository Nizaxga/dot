{
    "disable_ai": true,
    "vim_mode": true,
    "use_smartcase_search": true,
    "search": { "case_sensitive": true },
    "project_panel": { "hide_root": true },
    "preview_tabs": { "enabled": false },
    "format_on_save": "off",
    "tab_size": 4,
    "git": { "inline_blame": { "location": "status_bar" } },
    "cursor_blink": false,
    "title_bar": {
        "show_onboarding_banner": false,
        "show_user_picture": false,
        "show_user_menu": false,
        "show_sign_in": false
    },
    "git_panel": { "tree_view": true },
    "sticky_scroll": { "enabled": true },
    "relative_line_numbers": "enabled",
    "scrollbar": { "show": "never" },
    "ui_font_family": "IosevkaNLNice Nerd Font",
    "buffer_font_family": "IosevkaNLNice Nerd Font",
    "terminal": { "font_family": "IosevkaNLNice Nerd Font" },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "diagnostics": { "inline": { "enabled": true } },
    "ui_font_size": 16,
    "buffer_font_size": 16,
    "theme": "Gruvbox Dark Hard",
    "current_line_highlight": "none",
    "theme_overrides": {
        "Gruvbox Dark Hard": {
            "background": "#1d2021",
            "surface.background": "#1d2021",
            "elevated_surface.background": "#1d2021",
            "panel.background": "#1d2021",
            "title_bar.background": "#1d2021",
            "title_bar.inactive_background": "#1d2021",
            "status_bar.background": "#1d2021",
            "toolbar.background": "#1d2021",
            "tab_bar.background": "#1d2021",
            "tab.inactive_background": "#1d2021",
            "tab.active_background": "#3c3836",
            "terminal.background": "#1d2021",
            "editor.background": "#1d2021",
            "editor.gutter.background": "#1d2021",
            "editor.foreground": "#ebdbb2",
            "editor.line_number": "#665c54",
            "editor.active_line.background": "#3c383660",
            "border": "#3c3836",
            "border.variant": "#3c3836",
            "border.focused": "#3c3836",
            "pane.focused_border": "#3c3836",
            "panel.focused_border": "#3c3836",
            "text": "#ebdbb2",
            "text.muted": "#a89984",
            "element.hover": "#3c383680",
            "ghost_element.hover": "#3c383680",
            "ghost_element.selected": "#3c383680",
            "search.match_background": "#83a59870",
            "players": [
                {
                    "cursor": "#ebdbb2",
                    "background": "#ebdbb2",
                    "selection": "#689d6a40"
                }
            ],
            "syntax": {
                "comment":                { "color": "#928374", "font_style": "italic" },
                "comment.doc":            { "color": "#928374", "font_style": "italic" },
                "keyword":                { "color": "#fb4934" },
                "string":                 { "color": "#b8bb26" },
                "string.escape":          { "color": "#fb4934" },
                "string.regex":           { "color": "#fe8019" },
                "string.special":         { "color": "#b8bb26" },
                "number":                 { "color": "#d3869b" },
                "boolean":                { "color": "#d3869b" },
                "constant":               { "color": "#d3869b" },
                "function":               { "color": "#8ec07c" },
                "constructor":            { "color": "#fabd2f" },
                "type":                   { "color": "#fabd2f" },
                "enum":                   { "color": "#fabd2f" },
                "variant":                { "color": "#fabd2f" },
                "variable":               { "color": "#ebdbb2" },
                "variable.special":       { "color": "#d3869b" },
                "property":               { "color": "#83a598" },
                "operator":               { "color": "#8ec07c" },
                "attribute":              { "color": "#fabd2f" },
                "tag":                    { "color": "#8ec07c" },
                "label":                  { "color": "#83a598" },
                "preproc":                { "color": "#fe8019" },
                "punctuation":            { "color": "#a89984" },
                "punctuation.bracket":    { "color": "#d5c4a1" },
                "punctuation.delimiter":  { "color": "#a89984" },
                "punctuation.list_marker":{ "color": "#83a598" },
                "title":                  { "color": "#fe8019", "font_weight": 700 },
                "link_text":              { "color": "#928374" },
                "link_uri":               { "color": "#d3869b" },
                "text.literal":           { "color": "#8ec07c" },
                "emphasis":               { "font_style": "italic" },
                "emphasis.strong":        { "font_weight": 700 },
                "primary":                { "color": "#ebdbb2" }
            }
        }
    }
}
